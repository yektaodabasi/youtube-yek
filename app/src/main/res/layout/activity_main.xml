<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Spinner android:id="@+id/siteSpinner"
            android:layout_width="0dp" android:layout_height="48dp"
            android:layout_weight="1"/>
        <ImageButton android:id="@+id/btnSade"
            android:src="@android:drawable/ic_menu_view"
            android:contentDescription="Sadece video"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>
        <ImageButton android:id="@+id/btnEkle"
            android:src="@android:drawable/ic_input_add"
            android:contentDescription="Ekle"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>
        <ImageButton android:id="@+id/btnSil"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="Sil"
            android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>
    <WebView android:id="@+id/webView"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
